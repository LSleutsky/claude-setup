{
  "permissions": {
    "allow": [
      "Bash(npm run lint *)",
      "Bash(npm run typecheck *)",
      "Bash(npm run format:check *)",
      "Bash(npm ls *)",
      "Bash(pnpm run lint *)",
      "Bash(pnpm run typecheck *)",
      "Bash(pnpm run format:check *)",
      "Bash(pnpm lint *)",
      "Bash(pnpm typecheck *)",
      "Bash(pnpm ls *)",
      "Bash(yarn run lint *)",
      "Bash(yarn run typecheck *)",
      "Bash(yarn run format:check *)",
      "Bash(yarn lint *)",
      "Bash(yarn typecheck *)",
      "Bash(bun run lint *)",
      "Bash(bun run typecheck *)",
      "Bash(bun lint *)",
      "Bash(bun typecheck *)",
      "Bash(npx tsc --noEmit *)",
      "Bash(npx eslint *)",
      "Bash(npx oxlint *)",
      "Bash(npx prettier --check *)",
      "Bash(npx oxfmt --check *)",
      "Bash(npx biome check *)",
      "Bash(npm test *)",
      "Bash(pnpm test *)",
      "Bash(yarn test *)",
      "Bash(bun test *)",
      "Bash(npx vitest run *)",
      "Bash(npx jest *)",
      "Bash(git status *)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git show *)",
      "Bash(git rev-parse *)",
      "Bash(git merge-base *)",
      "Bash(git ls-files *)",
      "Bash(git remote get-url *)",
      "Bash(git branch --show-current)",
      "Bash(~/.claude/hooks/stack-rules.sh)",
      "Bash(~/.claude/hooks/repo-key.sh)",
      "Bash(~/.claude/hooks/base-ref.sh)"
    ],
    "ask": [
      "Bash(git commit *)",
      "Bash(git push *)",
      "Bash(git checkout -b *)",
      "Bash(git switch -c *)",
      "Bash(npm install *)",
      "Bash(npm i *)",
      "Bash(npm uninstall *)",
      "Bash(npm publish *)",
      "Bash(pnpm add *)",
      "Bash(pnpm install *)",
      "Bash(pnpm remove *)",
      "Bash(pnpm publish *)",
      "Bash(yarn add *)",
      "Bash(yarn install *)",
      "Bash(yarn remove *)",
      "Bash(yarn publish *)",
      "Bash(pip install *)",
      "Bash(uv add *)",
      "Bash(cargo add *)",
      "Bash(go get *)",
      "Bash(rm -r *)",
      "Bash(rm -rf *)",
      "Bash(rm -fr *)",
      "Bash(rm -R *)",
      "Bash(rm -Rf *)",
      "Bash(rm -fR *)",
      "Bash(rm --recursive *)",
      "Bash(find * -delete)",
      "Bash(git reset --hard *)",
      "Bash(git clean *)",
      "Bash(git checkout -- *)",
      "Bash(git checkout .)",
      "Bash(git restore *)",
      "Bash(git stash drop *)",
      "Bash(git stash clear)",
      "Bash(git branch -D *)",
      "Bash(git rebase *)",
      "Bash(git tag -d *)"
    ],
    "deny": [
      "Read(.env)",
      "Read(.env.*)",
      "Read(!.env.example)",
      "Read(!.env.sample)",
      "Read(!.env.template)",
      "Read(~/.ssh/**)",
      "Read(~/.aws/**)",
      "Read(**/*.pem)",
      "Read(**/*.key)",
      "Read(**/*.p12)",
      "Read(**/id_rsa*)",
      "Read(**/id_ed25519*)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact|fork",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/session-context.sh",
            "timeout": 5
          },
          {
            "type": "command",
            "command": "~/.claude/hooks/stack-rules.sh",
            "timeout": 5
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/turn-start.sh",
            "timeout": 5
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Edit|Write|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/write-guard.sh",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/bash-guard.sh",
            "timeout": 5
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/post-edit-check.sh",
            "timeout": 120
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/stop-check.sh",
            "timeout": 180
          }
        ]
      }
    ],
    "DirectoryAdded": [
      {
        "matcher": "slash_command",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/add-dir.sh",
            "timeout": 5
          }
        ]
      }
    ]
  },
  "enabledPlugins": {
    "typescript-lsp@claude-plugins-official": true
  }
}
